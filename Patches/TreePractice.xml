<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- Both defs are added even while the module is off: a pawn saved mid-job still loads, and XML caches such as
       Gagarin's (Missile Girl) do not rebuild when a mod setting changes. The recreation checks the setting itself. -->
  <Operation Class="VanillaTuneUp.PatchOperationTuneUp">
    <module>TreePractice</module>
    <evenWhenOff>true</evenWhenOff>
    <operations>
      <li Class="PatchOperationAdd">
        <xpath>Defs</xpath>
        <value>
          <JobDef>
            <defName>VTU_TreePractice</defName>
            <driverClass>VanillaTuneUp.JobDriver_TreePractice</driverClass>
            <reportString>practicing on TargetA.</reportString>
            <joyDuration>4000</joyDuration>
            <joyKind>Gaming_Dexterity</joyKind>
            <allowOpportunisticPrefix>true</allowOpportunisticPrefix>
            <!-- Keeps the weapon drawn between bursts and swings, as vanilla attack jobs do. -->
            <alwaysShowWeapon>true</alwaysShowWeapon>
          </JobDef>
          <!-- Picked like any other recreation; same kind as horseshoes and hoopstone. -->
          <JoyGiverDef>
            <defName>VTU_TreePractice</defName>
            <giverClass>VanillaTuneUp.JoyGiver_TreePractice</giverClass>
            <baseChance>2</baseChance>
            <jobDef>VTU_TreePractice</jobDef>
            <joyKind>Gaming_Dexterity</joyKind>
            <requiredCapacities>
              <li>Manipulation</li>
              <li>Moving</li>
              <li>Sight</li>
            </requiredCapacities>
          </JoyGiverDef>
        </value>
      </li>
    </operations>
  </Operation>
</Patch>
